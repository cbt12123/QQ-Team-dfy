# 复制为 pet-app/.env；此文件不填入真实密钥，不提交 .env。
PET_PUBLIC_URL=http://127.0.0.1:8899
PET_HOST=127.0.0.1
PORT=8899
# 本地默认 .cache/pet-app-data；生产必须指向真正的持久磁盘。
# PET_DATA_DIR=/var/lib/dafeyu

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 兼容 /audio/transcriptions 和 /audio/speech 的接口；与聊天提供商可不同。
PET_ASR_BASE_URL=
PET_ASR_API_KEY=
PET_ASR_MODEL=whisper-1
PET_TTS_BASE_URL=
PET_TTS_API_KEY=
PET_TTS_MODEL=tts-1
PET_TTS_VOICE=alloy

# 64位十六进制密钥，可用 cli.mjs keygen 生成；离线单独保管。
PET_BACKUP_KEY=
# 生产必须真正独立于应用磁盘；本机普通目录不等于独立云备份。
PET_BACKUP_DIR=
# 删除日志即时镜像到独立存储；必须随备份长期保留最新版本。
PET_DELETION_MIRROR_DIR=

# 离线恢复时使用，PET_RESTORE_TARGET 必须为空目录。
PET_RESTORE_ARCHIVE=
PET_RESTORE_TARGET=
PET_DELETION_JOURNAL=

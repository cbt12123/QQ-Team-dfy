extends SceneTree

func _init() -> void:
    var source = load("res://pet_state.gd")
    if source == null:
        push_error("Missing native pet state implementation")
        quit(1)
        return
    var state = source.new()
    assert(state.action == "idle")
    assert(state.play("feed"))
    assert(state.play("wave"))
    assert(state.action == "wave")
    state.ended()
    assert(state.action == "idle")
    state.sleep()
    assert(state.action == "sleep_start")
    state.ended()
    assert(state.action == "sleep_loop")
    assert(not state.play("feed"))
    state.wake()
    assert(state.action == "sleep_end")
    state.ended()
    assert(state.action == "idle")
    state.begin_drag(Vector2(20, 20))
    state.drag_to(Vector2(25, 22), Rect2(-70, -40, 140, 60))
    assert(not state.end_drag())
    state.begin_drag(Vector2.ZERO)
    state.drag_to(Vector2(2000, -2000), Rect2(-70, -40, 140, 60))
    assert(state.offset == Vector2(70, -40))
    assert(state.end_drag())
    assert(state.action == "idle")
    state.begin_drag(Vector2.ZERO)
    state.drag_to(Vector2(2000, 2000), Rect2(-70, -40, 140, 60))
    assert(state.offset == Vector2(70, 20))
    state.end_drag()
    var api = load("res://api_client.gd").new()
    assert(api.valid_base("https://example.com"))
    assert(api.valid_base("http://10.0.2.2:8899"))
    assert(not api.valid_base("http://example.com"))
    assert(not api.valid_base("https://user:password@example.com"))
    assert(not api.valid_base("http://localhost.evil.com"))
    api.free()
    print("PASS: native action/sleep/drag state and safe server URLs")
    quit(0)

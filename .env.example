# ============================================================
# QQ 群 @ 聊天机器人配置
# 复制为 .env 后填写；不要提交 .env 到 Git。
# ============================================================

# 接入方式：auto | official | napcat
# auto：填了 QQ_APP_ID + QQ_APP_SECRET 就用官方接口，否则用 NapCat
ADAPTER=auto

# ------------------------------------------------------------
# 方式一：官方 QQ 机器人（推荐，合规、稳定）
# 在 https://q.qq.com/ 创建机器人后获得 AppID / AppSecret
# ------------------------------------------------------------
QQ_APP_ID=
QQ_APP_SECRET=

# 官方 API 地址。正式环境默认即可；沙箱环境按开放平台文档填写。
QQ_API_BASE=https://api.bot.qq.com
# 一般不用改；默认等于 ${QQ_API_BASE}/app/getAppAccessToken
QQ_TOKEN_URL=

# 只允许这些群使用，留空表示不限制。多个群用英文逗号分隔。
# 官方接口填 group_openid，NapCat 填群号。
QQ_ALLOWED_GROUPS=
NAPCAT_ALLOWED_GROUPS=

# 允许私聊机器人的 QQ 号；留空表示禁止私聊。多个用英文逗号分隔。
NAPCAT_PRIVATE_ALLOWED_USERS=

# ------------------------------------------------------------
# 方式二：NapCat / OneBot 11（个人 QQ，非官方，存在封号风险）
# NapCat 里开启「WebSocket 服务器」，默认端口 3001
# ------------------------------------------------------------
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_ACCESS_TOKEN=

# ------------------------------------------------------------
# 大模型（任意 OpenAI 兼容接口）
# 不填 LLM_API_KEY 时进入演示模式：只会复读，不会真正聊天。
# DeepSeek：https://api.deepseek.com/v1
# OpenAI：https://api.openai.com/v1
# 本地 Ollama：http://127.0.0.1:11434/v1（Key 随便填一个非空值）
# ------------------------------------------------------------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=800
LLM_TIMEOUT_MS=60000

# ------------------------------------------------------------
# 机器人行为
# ------------------------------------------------------------
BOT_NAME=群助手

# 回答过长时自动分条发送；单条最大字符数（官方建议 <= 1500）
REPLY_MAX_CHARS=1200
# 每次 @ 最多回复几条（官方被动回复上限为 5 条）
REPLY_MAX_PARTS=4

# 每个用户记住最近多少轮对话、记忆保留分钟数
MAX_HISTORY_TURNS=8
HISTORY_TTL_MINUTES=120

# 群聊旁听上下文（只用于被 @ 时的背景，不会自动接话）
GROUP_CONTEXT_MAX_MESSAGES=80
GROUP_CONTEXT_MAX_CHARS=12000
GROUP_CONTEXT_MESSAGE_CHARS=500
GROUP_CONTEXT_RENDER_MESSAGES=50
GROUP_CONTEXT_TTL_MINUTES=360

# 数据目录：持久化对话记忆和群聊上下文
DATA_DIR=./data

# 联网搜索：遇到“查资料/搜一下/推荐/最新/案例”等消息时自动搜索
SEARCH_ENABLED=1
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_MS=15000

# 功能开关
REPLY_ENABLED=1
FORWARD_ENABLED=1
WEATHER_ENABLED=1

# 家庭关系设定（只影响该 QQ 的称呼，不会让机器人对所有人叫爸爸）
FAMILY_FATHER_QQ=
FAMILY_FATHER_CITY=西安
FAMILY_FATHER_JOB=程序员

# 天气：默认西安，使用 Open-Meteo，无需 Key
WEATHER_CITY=西安
WEATHER_LATITUDE=34.3416
WEATHER_LONGITUDE=108.9398
WEATHER_TIMEZONE=Asia/Shanghai
WEATHER_TIMEOUT_MS=10000

# 看图：使用 DeepSeek 视觉模型，复用同一把 LLM_API_KEY
VISION_ENABLED=1
VISION_MODEL=deepseek-flash
VISION_MAX_IMAGES=3
VISION_TIMEOUT_MS=20000

# 生图：Pollinations 免 Key
IMAGE_GEN_ENABLED=1
IMAGE_GEN_BASE_URL=https://image.pollinations.ai/prompt
IMAGE_GEN_WIDTH=1024
IMAGE_GEN_HEIGHT=1024
IMAGE_GEN_MODEL=

# Breeze TTS 2：正常说话（优先于 edge-tts）
BREEZE_ENABLED=1
BREEZE_URL=http://127.0.0.1:7860
BREEZE_INSTRUCTION=一位可爱、活泼、声音清甜的少女，说话自然亲切，带一点调皮，像在跟爸爸聊天。
BREEZE_CFG_SCALE=4
BREEZE_SEED=42
BREEZE_TIMEOUT_MS=120000

# 唱歌：独立 DiffSinger SVS 容器（当前关闭）
SVS_ENABLED=0
SVS_URL=http://127.0.0.1:8765
SVS_TIMEOUT_MS=30000
SVS_STEPS=20

# 语音：edge-tts（正常说话）
VOICE_ENABLED=1
VOICE_ALWAYS=0
VOICE_SINGING=1
VOICE_EDGE_BIN=edge-tts
VOICE_NAME=zh-CN-XiaoyiNeural
VOICE_RATE=+8%
VOICE_PITCH=+6Hz
VOICE_VOLUME=+0%
VOICE_MAX_CHARS=300
VOICE_TIMEOUT_MS=30000

# 主动接话：不开就是“只回 @”
PROACTIVE_ENABLED=0
# 只在这些群主动说话，多个群号用英文逗号分隔
PROACTIVE_GROUPS=
PROACTIVE_COOLDOWN_SEC=120
PROACTIVE_MAX_PER_HOUR=10
PROACTIVE_CHANCE=0.35
PROACTIVE_DEBOUNCE_MS=4000
PROACTIVE_MIN_CHARS=4
PROACTIVE_MAX_CHARS=160
# 模型第一次想沉默时，是否再要求它给一句短反应
PROACTIVE_RETRY_ON_SKIP=1
# 静默时段，支持 1-7 或 23-6,12-13；留空表示全天不静默
PROACTIVE_QUIET_HOURS=

# 自定义人设，保持单行
LLM_SYSTEM_PROMPT=你是 QQ 群里的 AI 助手，名字叫{botName}。回答要简洁、友好、口语化，默认使用中文。不要编造不知道的事实。群聊里不要长篇大论，除非用户明确要求详细说明。

# debug | info | warn | error
LOG_LEVEL=info

# 设为 1 时只打印要发送的内容，不真正发到 QQ（用于本地调试）
BOT_DRY_RUN=0
